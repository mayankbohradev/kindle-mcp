{
  "name": "kindle-mcp",
  "version": "2.0.0",
  "description": "MCP server that parses Kindle highlight exports and returns them grouped by highlight color",
  "main": "dist/index.js",
  "bin": {
    "kindle-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);fs.chmodSync(f,0o755);\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "kindle",
    "highlights",
    "reading",
    "model-context-protocol"
  ],
  "author": "Silvia Castro",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "wrangler": "^4.140.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
